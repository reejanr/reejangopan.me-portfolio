{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/projects/internal-erp-platform",
      "destination": "/projects/custom-erp-crm-systems",
      "permanent": true
    },
    {
      "source": "/projects/usf-demolition-digital-platform",
      "destination": "/projects/usf-group-web-platforms",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/system-design", "destination": "/system-design/index" },
    { "source": "/system-design/learn/:path*", "destination": "/system-design/index" },
    { "source": "/system-design/practice", "destination": "/system-design/index" },
    { "source": "/system-design/lab", "destination": "/system-design/index" },
    { "source": "/system-design/atlas", "destination": "/system-design/index" },
    { "source": "/system-design/atlas/compare", "destination": "/system-design/index" },
    { "source": "/system-design/atlas/challenge/:slug", "destination": "/system-design/index" },
    { "source": "/system-design/atlas/:slug", "destination": "/system-design/index" },
    { "source": "/system-design/cheatsheets", "destination": "/system-design/index" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/system-design/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
